{
    "name": "dts/site-hardening",
    "description": "A WordPress plugin that sends a Content-Security-Policy and the other security headers, refuses XML-RPC, turns Application Passwords off and hides version details; each site adds the outside sources its pages need.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/direct-technical-solutions/dts-site-hardening",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/direct-technical-solutions/dts-site-tools"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "dts/site-tools": "0.4.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
